            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "Healthy"
                },
                "1": {
                  "color": "yellow",
                  "index": 1,
                  "text": "Warning"
                },
                "2": {
                  "color": "red",
                  "index": 2,
                  "text": "Critical"
