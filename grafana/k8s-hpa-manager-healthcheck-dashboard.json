        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "Ultimo Check",
              "cluster": "Cluster"
            }
          }
        }
      ],
      "type": "table"
